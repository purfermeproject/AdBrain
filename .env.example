# ---------------- Local PostgreSQL ----------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=adbrain_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# Alternative: DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/adbrain_db

# ---------------- AI provider ----------------
# gemini | openai
AI_PROVIDER=gemini

# Gemini (recommended for this build, matches Creative OS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ---------------- Meta Marketing API ----------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_GRAPH_VERSION=v21.0
# Any long random string — used to derive the AES-256-GCM key that encrypts
# stored OAuth access tokens (lib/crypto.ts). Required before connecting a
# Meta ad account; generate one with `openssl rand -hex 32`.
META_TOKEN_ENCRYPTION_KEY=

# ---------------- Creative OS integration ----------------
# Base URL of the creatives_system app and a shared service-to-service key
# for the hypothesis hand-off and performance/learning sync (wired in Phase 5-6).
CREATIVE_OS_BASE_URL=http://localhost:3001
CREATIVE_OS_SERVICE_KEY=

# ---------------- Workspace defaults ----------------
# Matches Creative OS's existing workspace/brand/product ids so rows join
# across both databases without a mapping table.
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEMO_BRAND_ID=PF
DEMO_PRODUCT_ID=PF-COOKIE-BRK
